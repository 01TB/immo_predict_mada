# Copy this file to .env and fill in your own values
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

DB_NAME=immo_predict_mada
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Optional: only if Django cannot find GDAL on its own (common on Windows)
# GDAL_LIBRARY_PATH=C:\path\to\site-packages\osgeo\gdal.dll
